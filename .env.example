# App registration in Microsoft Entra ID (type: Single-page application).
# Redirect URI to register: http://localhost:5174
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# SharePoint site that holds the list: hostname plus server-relative path.
# Root site:      semantica.sharepoint.com
# Sub site:       semantica.sharepoint.com:/sites/Qualita
VITE_SP_SITE=semantica.sharepoint.com

# List display name (or its GUID).
VITE_SP_LIST=Non Conformità

# Optional: comma-separated internal column names, to show only these and in
# this order (matching the Lists form). Empty = every editable column of the
# list's default content type, in content-type order.
VITE_SP_FIELDS=

# List on the same site holding the Operatori address book (name -> e-mail):
# columns Title (the name) and Email (single line of text).
VITE_SP_OPERATORS_LIST=Operatori NC
